{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "targets": ["agentsskills", "antigravity-cli"],
  "features": ["skills"],
  "outputRoots": ["."],
  "delete": false,
  "verbose": true,
  "silent": false,
  "global": true,
  "simulateCommands": false,
  "simulateSubagents": false,
  "simulateSkills": false,
  "sources": [
    {
      "transport": "git",
      "source": "https://github.com/mattpocock/skills",
      "path": "skills/engineering",
      "skills": ["*"],
    },
    // mattpocock/skills/engineering と mattpocock/skills/productivity を同時に定義したい
    // 同時に定義すると rulesync install 時に片方が削除されてしまうのでフォークしたリポジトリを作成してそちらを参照する
    {
      "transport": "github",
      "source": "mattpocock/skills@main:.",
      "path": "skills/productivity",
      "skills": ["*"],
    },
    {
      "transport": "git",
      "source": "https://github.com/cursor/plugins",
      "path": "pstack/skills",
      "skills": ["*"],
    },
    {
      "source": "nanaism/yomiyasu",
      "path": "skills",
      "skills": ["yomiyasu"],
    },
    {
      "source": "mizchi/explainer",
      "path": "skills",
      "skills": ["explainer"],
    },
    {
      "source": "ast-grep/agent-skill",
      "path": "ast-grep/skills",
      "skills": ["ast-grep", "outline"],
    },
    {
      "source": "tt-a1i/archify",
      "path": ".",
      "skills": ["archify"],
    },
    {
      "source": "pbakaus/impeccable",
      "path": ".agents/skills",
      "skills": ["impeccable"],
    },
    {
      "transport": "git",
      "source": "https://github.com/herdrdev/herdr.git",
      "path": "skills",
      "skills": ["herdr"],
    },
  ],
}
