{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/config-schema.json",
  "targets": ["agentsskills", "antigravity-cli"],
  "features": ["skills"],
  "outputRoots": ["."],
  "delete": false,
  "verbose": true,
  "silent": false,
  "global": true,
  "simulateCommands": false,
  "simulateSubagents": false,
  "simulateSkills": false,
  "sources": [
    {
      "transport": "git",
      "source": "https://github.com/mattpocock/skills",
      "path": "skills/engineering",
      "skills": ["*"],
    },
    // mattpocock/skills/engineering と mattpocock/skills/productivity を同時に定義したい
    // 同時に定義すると rulesync install 時に片方が削除されてしまうのでフォークしたリポジトリを作成してそちらを参照する
    {
      "transport": "github",
      "source": "mattpocock/skills@main:.",
      "path": "skills/productivity",
      "skills": ["*"],
    },
    {
      "transport": "git",
      "source": "https://github.com/cursor/plugins",
      "path": "pstack/skills",
      "skills": [
        "architect",
        "arena",
        "benchmark-checklist",
        "principle-attack-the-premise",
        "principle-build-the-lever",
        "principle-boundary-discipline",
        "principle-encode-lessons-in-structure",
        "principle-exhaust-the-design-space",
        "principle-experience-first",
        "principle-explain-the-number",
        "principle-fix-root-causes",
        "principle-foundational-thinking",
        "principle-guard-the-context-window",
        "principle-laziness-protocol",
        "principle-make-operations-idempotent",
        "principle-migrate-callers-then-delete-legacy-apis",
        "principle-minimize-reader-load",
        "principle-model-the-domain",
        "principle-never-block-on-the-human",
        "principle-outcome-oriented-execution",
        "principle-prove-it-works",
        "principle-redesign-from-first-principles",
        "principle-separate-before-serializing-shared-state",
        "principle-sequence-verifiable-units",
        "principle-subtract-before-you-add",
        "principle-test-behavior-not-implementation",
        "principle-type-system-discipline",
        "typescript-best-practices",
      ],
    },
    {
      "source": "nanaism/yomiyasu",
      "path": "skills",
      "skills": ["yomiyasu"],
    },
    {
      "source": "herdrdev/herdr",
      "ref": "master",
      "path": "skills",
      "skills": ["herdr"],
    },
    {
      "source": "mizchi/explainer",
      "path": "skills",
      "skills": ["explainer"],
    },
    {
      "source": "ast-grep/agent-skill",
      "path": "ast-grep/skills",
      "skills": ["ast-grep", "outline"],
    },
    {
      "source": "tt-a1i/archify",
      "path": ".",
      "skills": ["archify"],
    },
  ],
}
