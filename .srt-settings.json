{
  "network": {
    "allowedDomains": [
      "github.com",
      "*.github.com",
      "githubusercontent.com",
      "*.githubusercontent.com",
      "npmjs.com",
      "*.npmjs.com",
      "openai.com",
      "*.openai.com",
      "anthropic.com",
      "*.anthropic.com",
      "opencode.ai",
      "*.opencode.ai",
      "api.newrelic.com",
      "*.newrelic.com"
    ],
    "deniedDomains": [],
    "allowUnixSockets": [
      "/var/run/docker.sock"
    ],
    "allowAllUnixSockets": true,
    "allowLocalBinding": false
  },
  "filesystem": {
    "denyRead": [
      "/Users"
    ],
    "allowRead": [
      ".",
      "~/.local/share/mise",
      "~/.local/share/claude",
      "~/.local/share/opencode",
      "~/.local/share/uv",
      "~/.cache",
      "~/.gemini",
      "~/.pi",
      "~/.opencode"
    ],
    "allowWrite": [
      ".",
      "/tmp",
      "/tmp/**/*",
      "~/.local/share/mise",
      "~/.local/share/claude",
      "~/.local/share/opencode",
      "~/.local/share/uv",
      "~/.cache",
      "~/.gemini",
      "~/.pi",
      "~/.opencode"
    ],
    "denyWrite": []
  },
  "ignoreViolations": {},
  "enableWeakerNestedSandbox": false,
  "enableWeakerNetworkIsolation": false
}
